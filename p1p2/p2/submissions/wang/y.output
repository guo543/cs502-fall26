Grammar

    0 $accept: Program $end

    1 Program: MainClass

    2 MainClass: KW_CLASS ID '{' StaticVarDeclList StaticMethodDeclList MainMethod '}'

    3 MainMethod: KW_PUBLIC KW_STATIC KW_VOID KW_MAIN '(' MainMethodArgs ')' '{' StatementList '}'

    4 MainMethodArgs: KW_STRING '[' ']' ID

    5 PrimeType: KW_INT
    6          | KW_BOOLEAN
    7          | KW_STRING

    8 Type: PrimeType
    9     | Type '[' ']'

   10 StaticVarDeclList: StaticVarDeclList StaticVarDecl
   11                  | ε

   12 StaticVarDecl: KW_PRIVATE KW_STATIC VarDeclLine

   13 VarDeclLine: Type ID VarInit ExtraVarDecl ';'

   14 ExtraVarDecl: ExtraVarDecl ',' ID VarInit
   15             | ε

   16 VarInit: '=' Exp
   17        | ε

   18 StaticMethodDeclList: StaticMethodDeclList StaticMethodDecl
   19                     | ε

   20 StaticMethodDecl: KW_PUBLIC KW_STATIC Type ID '(' FormalList ')' '{' StatementList '}'

   21 MethodCall: ID '(' ExpList ')'
   22           | PARSEINT '(' Exp ')'

   23 FormalList: FormalList ',' FormalVar
   24           | FormalVar
   25           | ε

   26 FormalVar: Type ID

   27 LeftValue: ID Index

   28 StatementList: StatementList Statement
   29              | ε

   30 Statement: VarDeclLine
   31          | '{' StatementList '}'
   32          | KW_IF '(' Exp ')' Statement KW_ELSE Statement
   33          | KW_WHILE '(' Exp ')' Statement
   34          | PRINTLN '(' Exp ')' ';'
   35          | PRINT '(' Exp ')' ';'
   36          | LeftValue '=' Exp ';'
   37          | KW_RETURN Exp ';'
   38          | MethodCall ';'

   39 ExpList: ExpList ',' Exp
   40        | Exp
   41        | ε

   42 ExpL16: '(' Exp ')'
   43       | INT_LITERAL
   44       | STR_LITERAL
   45       | KW_TRUE
   46       | KW_FALSE
   47       | LeftValue LENGTH
   48       | LeftValue
   49       | MethodCall
   50       | KW_NEW PrimeType '[' Exp ']' Index

   51 ExpL14: '+' ExpL14
   52       | '-' ExpL14
   53       | '!' ExpL14
   54       | ExpL16

   55 ExpL12: ExpL12 '*' ExpL14
   56       | ExpL12 '/' ExpL14
   57       | ExpL14

   58 ExpL11: ExpL11 '-' ExpL12
